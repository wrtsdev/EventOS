{
  "name": "wrts-eventos",
  "private": true,
  "version": "0.1.0",
  "description": "WRTS EventOS — the community operating system for walks, runs, and movement-powered experiences.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --test tests/*.test.js",
    "check": "npm run test && npm run build",
    "build:artifact": "EVENTOS_BASE=./ vite build && node scripts/build-artifact.mjs",
    "start": "node server/index.js",
    "ios:sync": "cap sync ios",
    "ios:open": "cap open ios"
  },
  "dependencies": {
    "@capacitor/app": "8.1.2",
    "@capacitor/browser": "8.0.5",
    "@capacitor/core": "8.6.3",
    "@capacitor/filesystem": "8.1.5",
    "@capacitor/ios": "8.6.3",
    "@capacitor/share": "8.0.3",
    "@capacitor/splash-screen": "8.0.2",
    "@capacitor/status-bar": "8.0.4",
    "@vitejs/plugin-react": "4.7.0",
    "bcryptjs": "2.4.3",
    "express": "4.22.3",
    "mysql2": "3.24.6",
    "nodemailer": "10.3.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "vite": "6.4.5"
  },
  "overrides": {
    "esbuild": "0.28.1"
  },
  "devDependencies": {
    "@capacitor/cli": "8.6.3"
  }
}
