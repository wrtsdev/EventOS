{
  "name": "wrts-eventos",
  "private": true,
  "version": "0.1.0",
  "description": "WRTS EventOS — the community operating system for walks, runs, and movement-powered experiences.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --test tests/*.test.js",
    "check": "npm run test && npm run build",
    "build:artifact": "EVENTOS_BASE=./ vite build && node scripts/build-artifact.mjs",
    "start": "node server/index.js"
  },
  "dependencies": {
    "@vitejs/plugin-react": "4.7.0",
    "bcryptjs": "2.4.3",
    "express": "4.22.3",
    "mysql2": "3.24.6",
    "nodemailer": "10.3.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "vite": "6.4.5"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "4.3.4",
    "vite": "5.4.21"
  }
}
