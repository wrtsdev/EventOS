# EventOS environment template. Copy to .env for local development only.
# Never commit real values. In production, set these in hPanel → Node.js → Environment variables.

NODE_ENV=development
PORT=3000
PUBLIC_URL=http://localhost:3000

# 32+ random characters. Encrypts stored integration keys and two-step secrets.
# Changing it makes saved keys and two-step setups unreadable.
APP_SECRET=

# Database (Hostinger's database setup writes DB_* and DATABASE_URL in production)
DATABASE_URL=
# or: DB_HOST=127.0.0.1  DB_PORT=3306  DB_NAME=  DB_USER=  DB_PASSWORD=

# Master administrator, designated once when no master exists (docs/ADMIN_GUIDE.md)
MASTER_ADMIN_EMAIL=

# Transactional email (Hostinger: smtp.hostinger.com, port 465)
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=

# Optional
SESSION_DAYS=14
DEMO_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
